{
    "name": "ernestdefoe/question-of-the-day",
    "description": "Question of the Day: one prompt a day on your forum's front page. Members answer briefly, everyone else's answers stay hidden until you post yours, then react to the best. Streaks, an archive, member-suggested questions with upvotes and a moderation queue, a rollover at your local midnight, and an optional daily discussion.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "question of the day",
        "daily question",
        "engagement",
        "streaks",
        "community"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/question-of-the-day",
    "support": {
        "issues": "https://github.com/ernestdefoe/question-of-the-day/issues",
        "source": "https://github.com/ernestdefoe/question-of-the-day"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\QuestionOfTheDay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\QuestionOfTheDay\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Question of the Day",
            "category": "feature",
            "icon": {
                "name": "fas fa-comment-dots",
                "backgroundColor": "#7c3aed",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/gdpr",
                "flarum/tags"
            ]
        }
    },
    "require-dev": {
        "flarum/gdpr": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
